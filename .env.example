# ========================================================
# SHIELD HER - Environment Configuration Example
# Copy this file to '.env' for local development
# ========================================================

# Flask Application Settings
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-in-production-use-a-strong-random-hex-string

# Database
# Defaults to sqlite:///shield_her.db in instance/ folder
DATABASE_URL=sqlite:///shield_her.db

# Evidence Upload Security
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216  # 16 MB max upload

# Email Configuration (Optional - for password reset)
# If unconfigured, the reset token link will be displayed securely in development
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@shieldher.local

# Twilio SMS Configuration (Optional - for real SOS SMS delivery)
# If unconfigured, SOS provides one-tap browser share, WhatsApp link, and clipboard copy
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
